@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title C3 – App Web Clientes | Gestión de Suscripciones

Container_Boundary(webAppClientes, "App Web", "React SPA") {

    Component(routeGuard, "ProtectedRoute", "Router Guard", "Protege rutas privadas")

    Component(inicioPage, "InicioPage", "React Component", "Página principal de la plataforma")
    Component(promociones, "Promociones", "React Component", "Visualización de promociones y campañas vigentes")
    Component(promocionesHook, "usePromocionesHook", "Custom Hook", "Gestiona promociones")
    Component(promocionesServices, "PromocionesServices", "API Client", "Operaciones REST promociones")

    Component(suscripcionesPage, "SuscripcionesPage", "React Component", "Gestión de suscripciones del usuario")
    Component(suscripciones, "Suscripciones", "React Component", "Suscripciones del usuario")
    Component(pagos, "Pagos", "React Component", "Gestión de pagos")

    Component(suscripcionesFacade, "SuscripcionesFacade", "Facade", "Compone y adapta datos para la interfaz")

    Component(suscripcionesHook, "useSuscripcionesHook", "Custom Hook", "Gestiona suscripciones")
    Component(pagosHook, "usePagosHook", "Custom Hook", "Gestiona pagos")

    Component(authHook, "useAuth", "Custom Hook", "Gestión de autenticación y sesión")

    Component(authStore, "AuthStore", "State Management", "Estado global de autenticación")
    Component(suscripcionesStore, "SuscripcionesStore", "State Management", "Estado global de suscripciones")

    Component(suscripcionesServices, "SuscripcionesServices", "API Client", "Operaciones REST")

    Component(baseApiClient, "BaseApiClient", "HTTP Client", "Cliente HTTP compartido")

    Component(authInterceptor, "AuthInterceptor", "HTTP Middleware", "Adjunta token JWT")
    Component(errorInterceptor, "ErrorInterceptor", "HTTP Middleware", "Manejo centralizado de errores")
}

Rel(routeGuard, authHook, "Valida sesión")

Rel(authHook, authStore, "Lee / Actualiza")

Rel(suscripcionesPage, suscripcionesFacade, "Usa")
Rel(suscripciones, suscripcionesFacade, "Usa")
Rel(pagos, suscripcionesFacade, "Usa")

Rel(inicioPage, promocionesHook, "Usa")
Rel(promociones, promocionesHook, "Usa")

Rel(suscripcionesFacade, suscripcionesHook, "Usa")
Rel(suscripcionesFacade, pagosHook, "Usa")

Rel(suscripcionesHook, suscripcionesStore, "Lee / Actualiza")
Rel(suscripcionesHook, suscripcionesServices, "Consume")

Rel(promocionesHook, promocionesServices, "Consume")

Rel(suscripcionesServices, baseApiClient, "Usa")
Rel(promocionesServices, baseApiClient, "Usa")

Rel(baseApiClient, authInterceptor, "Usa")
Rel(baseApiClient, errorInterceptor, "Usa")

Rel(authInterceptor, authStore, "Obtiene JWT")

@enduml