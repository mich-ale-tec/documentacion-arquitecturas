@startuml
!define C4P https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master
!includeurl C4P/C4_Context.puml

title Identificación de Actores y Límites del Sistema Toget

Person(provedor, "Proveedor de Cuentas", "Persona encargada de proporcionar cuentas de servicios de streaming")
Person(validador, "Validador de Cuentas", "Persona encargada de validar cuentas registradas y gestiona sus precios con los proveedores")
Person(aPerfil, "Administrador de Perfiles", "Persona encargada de gestionar la distribución, disponibilidad y precios de los perfiles")
Person(personalPagos, "Personal de Pagos", "Persona responsable de validar pagos y gestionar suscripciones")
Person(atencion, "Personal de Atención", "Persona encargada de atender consultas, solicitudes e incidencias de los usuarios")
Person(usuario, "Usuario", "Persona que explora la plataforma y adquiere suscripciones")

System(toget, "Toget", "Plataforma para la adquisición, distribución y administración de cuentas y perfiles de servicios de streaming")

System_Ext(whatsapp, "WhatsApp", "Canal de comunicación utilizado para notificaciones y campañas promocionales")
System_Ext(correo, "Correo Electrónico", "Canal principal para el envío de credenciales, información de acceso y comunicaciones")
System_Ext(pagos, "Pasarela de Pagos", "Servicio externo encargado del procesamiento de pagos")

Rel(provedor, toget, "Registra nuevas cuentas de streaming")
Rel(validador, toget, "Valida cuentas registradas y gestiona sus precios")
Rel(aPerfil, toget, "Administra la disponibilidad, asignación y precios de los perfiles")
Rel(personalPagos, toget, "Valida pagos y activa suscripciones")
Rel(atencion, toget, "Gestiona consultas e incidencias de los usuarios")
Rel(usuario, toget, "Consulta servicios y gestiona sus suscripciones")

Rel(toget, whatsapp, "Envía promociones, recordatorios y notificaciones")
Rel(toget, correo, "Envía credenciales de acceso, perfiles asignados y códigos PIN")
Rel(toget, pagos, "Procesa los pagos de las suscripciones adquiridas")

SHOW_LEGEND()
@enduml