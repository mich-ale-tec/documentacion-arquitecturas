@startuml
!define C4P https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master
!includeurl C4P/C4_Context.puml

title Identificación de Actores y Límites del Sistema Toget

Person(provedor, "Proveedor Cuentas", "Persona que proporciona cuentas de streaming")
Person(validador, "Validador Cuentas", "Persona que gestiona la autenticidad de las cuentas")
Person(aPerfil, "Administrador Perfiles", "Persona que gestiona la distribucion de los perfiles")
Person(personalPagos, "Personal Pagos", "Persona que gestiona las pagos y suscripciones")
Person(atencion, "Personal Atención", "Personal que gestiona las incidencias de la cuenta")
Person(suscriptor, "Suscriptor", "Persona que tiene suscripción activa")
Person(cliente, "Cliente", "Cliente potencial de adquisición")


System(tugeder, "Toget", "Plataforma que adquiere, distribuye y gestiona cuentas de streaming")
System_Ext(whatsapp,"WhatsApp", "Establece el canal de marketing")
System_Ext(correo,"Correo", "Establece el canal principal de suscripciones")
System_Ext(pagos, "Pasarela de Pagos", "Procesa pagos de servicios")

Rel(provedor, tugeder, "Registra una cuenta de streming")
Rel(validador, tugeder, "Verifica la autenticidad de las cuentas registradas")
Rel(aPerfil, tugeder, "Apertura cuentas, cantidad de perfiles y precios")
Rel(personalPagos, tugeder, "Habilita suscripciones")
Rel(atencion, tugeder, "Registra las incidencias de los usuarios")
Rel(suscriptor, tugeder, "Adquiere suscripcion")
Rel(cliente, tugeder, "Visitante ocasional/recurrente")


Rel(tugeder, whatsapp, "Envia promociones/notificaciones/avisos")
Rel(tugeder, correo, "Envio de credenciales a las suscriptores")
Rel(tugeder, pagos, "Procesa pagos de las suscripciones")


SHOW_LEGEND()
@enduml
